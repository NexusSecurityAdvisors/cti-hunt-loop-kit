// HL-0002 — LSASS Credential Dumping (ATT&CK T1003.001; related T1218.011)
// Platform: Microsoft Defender XDR Advanced Hunting / Microsoft Sentinel (DeviceProcessEvents)
// Playbook: playbooks/HL-0002-T1003.001-lsass-credential-dumping.md
// Note: in Sentinel, replace Timestamp with TimeGenerated.
let lookback = 14d; // Lab dataset: set to 3650d
// ProcDump-style full / mini / process-memory flags (mirrors the Sigma selection_procdump list)
let procdumpFlags = @"(?i)\s(-ma|/ma|-mm|-mp)\s";
DeviceProcessEvents
| where Timestamp > ago(lookback)
| where ProcessCommandLine contains "comsvcs" or ProcessCommandLine contains "lsass"
| extend IsComsvcs  = ProcessCommandLine contains "comsvcs"
                      and (ProcessCommandLine contains "MiniDump" or ProcessCommandLine contains "#24"),
         IsProcdump = ProcessCommandLine matches regex procdumpFlags and ProcessCommandLine contains "lsass",
         IsGeneric  = ProcessCommandLine contains "lsass" and ProcessCommandLine contains ".dmp"
| where IsComsvcs or IsProcdump or IsGeneric
| extend DumpMethod = case(IsComsvcs,  "comsvcs MiniDump",
                           IsProcdump, "ProcDump-style flags",
                                       "lsass + .dmp (generic)"),
         // comsvcs often targets LSASS by PID only: resolve it on the host (see playbook step 3)
         TargetPid  = extract(@"(?i)(MiniDump|#24)[\s,]+(\d+)", 2, ProcessCommandLine),
         DumpFile   = extract(@"(?i)(\S+\.dmp)\b", 1, ProcessCommandLine),
         // Renamed tool: on-disk name differs from the PE original file name
         Renamed    = isnotempty(ProcessVersionInfoOriginalFileName)
                      and tolower(FileName) != tolower(ProcessVersionInfoOriginalFileName)
                      and tolower(FileName) != strcat(tolower(ProcessVersionInfoOriginalFileName), ".exe")
| summarize
    Hits      = count(),
    Hosts     = dcount(DeviceName),
    FirstSeen = min(Timestamp),
    LastSeen  = max(Timestamp),
    SampleCommandLine = any(ProcessCommandLine),
    TargetPids        = make_set(TargetPid, 10),
    DumpFiles         = make_set(DumpFile, 10),
    FolderPaths       = make_set(FolderPath, 10),
    DeviceList        = make_set(DeviceName, 25)
    by DumpMethod, FileName, ProcessVersionInfoOriginalFileName, Renamed, InitiatingProcessFileName, AccountName
// Rare tool / parent / account combinations first
| order by Hits asc, Hosts asc
//
// ---------------------------------------------------------------------------------------------
// Optional second query: handle access to LSASS (catches tools that never put "lsass" on a
// command line). Defender XDR samples these events, so absence is not proof of absence.
// ---------------------------------------------------------------------------------------------
