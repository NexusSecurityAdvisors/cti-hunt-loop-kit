// | where Timestamp > ago(lookback)
// | where ActionType == "OpenProcessApiCall" and FileName =~ "lsass.exe"
// | extend DesiredAccess = tostring(parse_json(AdditionalFields).DesiredAccess)
// | summarize Hits = count(), Hosts = dcount(DeviceName), DeviceList = make_set(DeviceName, 25),
//             FirstSeen = min(Timestamp), LastSeen = max(Timestamp)
//             by InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessAccountName, DesiredAccess
// | order by Hits asc, Hosts asc
