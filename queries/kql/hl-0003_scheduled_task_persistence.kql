//          TaskContent = extract(@"<Data Name=""TaskContent"">([\s\S]*?)</Data>", 1, EventData)
// | extend Command     = extract(@"(?i)&lt;Command&gt;([^&]+)&lt;/Command&gt;", 1, TaskContent)
// | summarize Hits = count(), Hosts = dcount(Computer), HostList = make_set(Computer, 25)
//             by TaskName, Command, SubjectUserName
// | order by Hosts asc, Hits asc
